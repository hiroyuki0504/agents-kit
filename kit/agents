def fmt_d(n):
    return "d%05d" % n


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(s):
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except Exception:
        return None


def age_minutes(iso):
    t = parse_iso(iso)
    if t is None:
        return None
    return (datetime.now(timezone.utc) - t).total_seconds() / 60.0


def fmt_age(iso):
    m = age_minutes(iso)
    if m is None:
        return "?"
    if m < 1:
        return "たった今"
    if m < 60:
        return "%d分前" % int(m)
    if m < 1440:
        return "%.1f時間前" % (m / 60)
    return "%.1f日前" % (m / 1440)


def state_dumps(obj):
    # 決定的なバイト列（§4.1）。全 state ファイル共通。
    return (json.dumps(obj, ensure_ascii=False, indent=1, sort_keys=True) + "\n").encode("utf-8")


# ============================================================================
# git サブプロセス（全呼び出し LC_ALL=C LANG=C。§3.1/§14）
# ============================================================================

def git(args, cwd=None, env_extra=None, input_bytes=None):
    env = dict(os.environ)
    env["LC_ALL"] = "C"
    env["LANG"] = "C"
    if env_extra:
        env.update(env_extra)
    return subprocess.run(
        ["git"] + args, cwd=str(cwd or CTX.root), env=env,
        input=input_bytes, stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def _t(b):
    return b.decode("utf-8", "replace") if isinstance(b, (bytes, bytearray)) else str(b)


def rev_parse_q(ref, cwd=None):
    r = git(["rev-parse", "-q", "--verify", ref], cwd=cwd)
    return _t(r.stdout).strip() if r.returncode == 0 else None


def is_ancestor(a, b):
    return git(["merge-base", "--is-ancestor", a, b]).returncode == 0


def is_cas_stderr(stderr_text):
    return any(re.search(p, stderr_text) for p in PUSH_CAS_PATTERNS)


def _lock_retryable(stderr_text):
    # §3.1: ref ロック競合パターン
    s = stderr_text
    return ("cannot lock ref" in s or "could not lock" in s
            or ("Unable to create" in s and ".lock" in s)
            or "unable to update local ref" in s)


def fetch_branch(branch, allow_missing=False, state_missing_exit3=False):
    """明示 refspec fetch（§3.1 リトライ規約）。allow_missing: remote ref 不在を無視。"""
    last = ""
    for _ in range(FETCH_RETRY):
        r = git(["fetch", "--quiet", R(), "+refs/heads/%s:refs/remotes/%s/%s" % (branch, R(), branch)])
        if r.returncode == 0:
            return True
        last = _t(r.stderr)
        if _lock_retryable(last):
            time.sleep(random.uniform(0.1, 0.5))
            continue
        if "couldn't find remote ref" in last:
            if allow_missing:
                return False
            if state_missing_exit3:
                raise AgentsExit(3, "agent-state が無い。install.sh を実行せよ")
        raise AgentsExit(6, last.rstrip() + "\n" + FETCH_ADVICE)
    raise AgentsExit(6, "fetch リトライ上限（ref ロック競合が解消しない）。最後の stderr:\n" + last)


def fetch_main():
    fetch_branch(M())


def worktree_retry(args, cleanup=None):
    """worktree add / remove を §3.1 のリトライ規約で実行。"""
    last = ""
    for i in range(FETCH_RETRY):
        if i > 0 and cleanup:
            cleanup()
        r = git(args)
        if r.returncode == 0:
            return r
        last = _t(r.stderr)
        if _lock_retryable(last) or "already exists" in last:
            time.sleep(random.uniform(0.1, 0.5))
            continue
        raise AgentsExit(6, "git %s が失敗:\n%s" % (" ".join(args[:2]), last))
    raise AgentsExit(6, "worktree 操作のリトライ上限。最後の stderr:\n" + last)


