    wr = CTX.cfg["worktree_root"]
    p = Path(wr)
    return p if p.is_absolute() else (CTX.root / wr)


def self_ident():
    """自 worktree の agents.json（{"slug","agent","branch"}）。無ければ None（claim worktree 外）。"""
    r = git_nocwd(["rev-parse", "--absolute-git-dir"])
    if r.returncode != 0:
        return None
    p = Path(_t(r.stdout).strip()) / "agents.json"
    if not p.is_file():
        return None
    try:
        obj = json.loads(p.read_text(encoding="utf-8"))
        if all(k in obj for k in ("slug", "agent", "branch")):
            return obj
    except Exception:
        pass
    return None


def cwd_toplevel():
