# シンボル消失チェック（§7）
# ============================================================================

def _sym_set(rev, path, rx):
    raw = cat_blob(rev, path)
    if raw is None:
        return set()
    text = raw.decode("utf-8", "replace")
    out = set()
    for m in rx.finditer(text):
        for g in m.groups():
            if g is not None:
                out.add(g)
                break
    return out


def _blob_size(rev, path):
    r = git(["cat-file", "-s", "%s:%s" % (rev, path)])
    if r.returncode != 0:
        return None  # 欠如
    try:
        return int(_t(r.stdout).strip())
    except Exception:
        return None


def symbol_check(m_sha, br, res):
    """戻り値: (violations:[(file,symbol,kind)], unchecked:[(file,理由)])。"""
    rb = git(["merge-base", m_sha, br])
    if rb.returncode != 0:
        raise AgentsExit(6, "merge-base 失敗: " + _t(rb.stderr))
    b0 = _t(rb.stdout).strip()
    rd = git(["diff", "--no-renames", "--name-only", b0, br])
    if rd.returncode != 0:
        raise AgentsExit(6, "diff 失敗: " + _t(rd.stderr))
    changed = [n for n in _t(rd.stdout).split("\n") if n]
    violations, unchecked = [], []
    for f in changed:
        ext = Path(f).suffix.lower()
        rx = SYMBOL_TABLE.get(ext)
        if rx is None:
            unchecked.append((f, "拡張子が検査表に無い"))
            continue
        too_big = False
        for rev in (b0, br, m_sha, res):
            sz = _blob_size(rev, f)
            if sz is not None and sz > SYM_FILE_CAP:
                too_big = True
                break
        if too_big:
            unchecked.append((f, "1MB 超"))
            continue
        s_b0 = _sym_set(b0, f, rx)
        s_br = _sym_set(br, f, rx)
        s_m = _sym_set(m_sha, f, rx)
        s_res = _sym_set(res, f, rx)
        added = s_br - s_b0
        lost_added = added - s_res
        removed_by_br = s_b0 - s_br
        lost_main = (s_m - removed_by_br) - s_res
        for s in sorted(lost_added):
            violations.append((f, s, "added"))
        for s in sorted(lost_main):
            violations.append((f, s, "main"))
    return violations, unchecked


