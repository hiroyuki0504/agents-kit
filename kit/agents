class State:
    def __init__(self, tip, names, counter, directives, claims, lock):
        self.tip = tip
        self.names = names
        self.counter = counter
        self.directives = directives   # {seq:int -> obj}
        self.claims = claims           # {slug -> obj}
        self.lock = lock               # obj | None
        self.extra = {}                # precheck が mutate に渡す作業領域

    @property
    def maxd(self):
        return max(self.directives.keys(), default=0)


def cat_blob(rev, path):
    r = git(["cat-file", "blob", "%s:%s" % (rev, path)])
    return r.stdout if r.returncode == 0 else None


def load_state_from_tip(tip):
    r = git(["ls-tree", "-r", "--name-only", tip])
    if r.returncode != 0:
        raise AgentsExit(6, "ls-tree 失敗: " + _t(r.stderr))
    names = _t(r.stdout).split("\n")
    names = [n for n in names if n]
    counter = 0
    if "counter" in names:
        raw = cat_blob(tip, "counter")
        try:
            counter = int(_t(raw).strip() or "0")
        except Exception:
            raise AgentsExit(6, "state ファイルのパースに失敗: counter")
    directives, claims, lock = {}, {}, None
    for n in names:
        if n.startswith("directives/") and n.endswith(".json"):
            obj = _load_json_blob(tip, n)
            directives[int(obj["seq"])] = obj
        elif n.startswith("claims/") and n.endswith(".json"):
            obj = _load_json_blob(tip, n)
            claims[obj.get("slug") or Path(n).stem] = obj
        elif n == "locks/merge.json":
            lock = _load_json_blob(tip, n)
    return State(tip, names, counter, directives, claims, lock)


def _load_json_blob(tip, name):
    raw = cat_blob(tip, name)
    try:
        return json.loads(_t(raw))
    except Exception:
        raise AgentsExit(6, "state ファイルのパースに失敗: " + name)


def read_state():
    """§5.1 READ-STATE（fetch + 巻き戻り検知 + 全読込）。"""
    old = rev_parse_q("refs/remotes/%s/%s" % (R(), S()))
    fetch_branch(S(), state_missing_exit3=True)
    tip = rev_parse_q("refs/remotes/%s/%s" % (R(), S()))
    if tip is None:
        raise AgentsExit(3, "agent-state が無い。install.sh を実行せよ")
    if old is not None and not is_ancestor(old, tip):
        raise AgentsExit(6, ROLLBACK_MSG.format(R=R(), S=S()))
    return load_state_from_tip(tip)


def _apply_commit(tip, changes, msg):
    """一時 index の plumbing で tip の上に 1 コミットを作る（主 index/HEAD/作業ツリーに触れない）。"""
    tmpidx = CTX.common_gitdir / "agents-tmp" / ("idx-%d-%s" % (os.getpid(), secrets.token_hex(4)))
    env = {"GIT_INDEX_FILE": str(tmpidx)}
    try:
        r = git(["read-tree", "%s^{tree}" % tip], env_extra=env)
        if r.returncode != 0:
            raise AgentsExit(6, "read-tree 失敗: " + _t(r.stderr))
        for ch in changes:
            if ch[0] == "put":
                _, path, content = ch
                rb = git(["hash-object", "-w", "--stdin"], env_extra=env, input_bytes=content)
                if rb.returncode != 0:
                    raise AgentsExit(6, "hash-object 失敗: " + _t(rb.stderr))
                blob = _t(rb.stdout).strip()
                ru = git(["update-index", "--add", "--cacheinfo", "100644,%s,%s" % (blob, path)],
                         env_extra=env)
                if ru.returncode != 0:
                    raise AgentsExit(6, "update-index 失敗: " + _t(ru.stderr))
            elif ch[0] == "del":
                _, path = ch
                ru = git(["update-index", "--force-remove", path], env_extra=env)
                if ru.returncode != 0:
                    raise AgentsExit(6, "update-index --force-remove 失敗: " + _t(ru.stderr))
        rt = git(["write-tree"], env_extra=env)
        if rt.returncode != 0:
            raise AgentsExit(6, "write-tree 失敗: " + _t(rt.stderr))
        tree = _t(rt.stdout).strip()
        rc = git(["-c", "user.name=agents-kit", "-c", "user.email=agents-kit@local",
                  "commit-tree", tree, "-p", tip, "-m", msg])
        if rc.returncode != 0:
            raise AgentsExit(6, "commit-tree 失敗: " + _t(rc.stderr))
        return _t(rc.stdout).strip()
    finally:
        try:
            tmpidx.unlink()
        except OSError:
            pass


def write_state(precheck, mutate, msg, on_precheck_fail="exit"):
    """§5.2 WRITE-STATE（CAS）。全状態変更はこの 1 関数を通る。

    precheck(st) -> None | (code:int, msg:str)。前提評価は必ずループ内（I-CAS）。
    mutate(st)   -> [("put", path, bytes) | ("del", path)]。空/None は書き込み不要（no-op）。
    on_precheck_fail="skip" はハートビートと UNLOCK 専用（§5.2）。他は必ず exit。
    ローカル refs/heads/<state> は決して作らない（SHA:refspec push のみ）。
    """
    last_stderr = ""
    for attempt in range(CAS_MAX):
        st = read_state()                    # 毎回 fetch + 巻き戻り検知
        err = precheck(st) if precheck else None
        if err:
            if on_precheck_fail == "skip":
                print("警告: " + err[1])
                return None
            raise AgentsExit(err[0], err[1])
        changes = mutate(st)
        if not changes:
            return None                      # 書くものが無い（evict の全対象消滅など）
        msg_val = msg() if callable(msg) else msg   # seq 依存の msg（directive/evict）は mutate 後に確定
        commit = _apply_commit(st.tip, changes, msg_val)
        rp = git(["push", "--quiet", R(), "%s:refs/heads/%s" % (commit, S())],
                 env_extra={"AGENTS_STATE_TOKEN": "1"})
        if rp.returncode == 0:
            return commit
        last_stderr = _t(rp.stderr)
        if is_cas_stderr(last_stderr):
            time.sleep(random.uniform(0.2, 1.0) + 0.1 * attempt)  # CAS 敗北 = 正常イベント
            continue
        # 致命系の前に「適用済みだが応答が届かなかった」を 1 回だけ検査（書込の冪等化。§5.2）
        try:
            fetch_branch(S())
            tip2 = rev_parse_q("refs/remotes/%s/%s" % (R(), S()))
            if tip2 and is_ancestor(commit, tip2):
                return commit
        except AgentsExit:
            pass
        raise AgentsExit(6, last_stderr)
    raise AgentsExit(5, "CAS リトライ上限。少し待って再実行せよ。最後の stderr:\n" + last_stderr)


# ============================================================================
# パス重複判定（§6）
# ============================================================================

_WILD = set("*?[")


def _kind(p):
    return "pattern" if any(c in _WILD for c in p) else "literal"


def _foot(pat):
    idx = len(pat)
    for i, c in enumerate(pat):
        if c in _WILD:
            idx = i
            break
    pre = pat[:idx]
    j = pre.rfind("/")
    return pre[:j + 1] if j >= 0 else ""


def _overlap1(a, b, files):
    ka, kb = _kind(a), _kind(b)
    if ka == "literal" and kb == "literal":
        return a == b or a.startswith(b + "/") or b.startswith(a + "/")
    if ka == "literal" or kb == "literal":
        lit, pat = (a, b) if ka == "literal" else (b, a)
        return fnmatch.fnmatchcase(lit, pat) or lit.startswith(_foot(pat))
    fa, fb = _foot(a), _foot(b)
    if fa.startswith(fb) or fb.startswith(fa):
        return True  # foot "" のパターンは全体と交差扱い（安全側）
    ma = {f for f in files if fnmatch.fnmatchcase(f, a)}
    mb = {f for f in files if fnmatch.fnmatchcase(f, b)}
    return bool(ma & mb)


def find_overlap(paths_a, paths_b, files):
    for a in paths_a:
        for b in paths_b:
            if _overlap1(a, b, files):
                return (a, b)
    return None


def ls_tree_files(rev):
    r = git(["ls-tree", "-r", "--name-only", rev])
    if r.returncode != 0:
        raise AgentsExit(6, "ls-tree 失敗: " + _t(r.stderr))
    return [n for n in _t(r.stdout).split("\n") if n]


