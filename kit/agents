def build_parser():
    ap = argparse.ArgumentParser(prog="agents", description="マルチAIセッション協調 CLI（agents-kit）")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("directive", help="ユーザー指示原文を台帳に記録")
    p.add_argument("text")
    p.add_argument("--scope", default="")
    p.add_argument("--supersedes", default="")
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("start", help="claim + SHA固定 worktree + branch 作成")
    p.add_argument("slug")
    p.add_argument("--directive", required=True)
    p.add_argument("--paths", required=True)
    p.add_argument("--intent", required=True)
    p.add_argument("--interfaces", default="")

    p = sub.add_parser("sync", help="fetch + 状態表示 + claim 延命")
    p.add_argument("--all", action="store_true")
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("status", help="表示のみ（fetch なし・オフライン可）")
    p.add_argument("--json", action="store_true")

    p = sub.add_parser("done", help="rebase → 全テスト → push → PR(任意)")
    p.add_argument("--seen")

    p = sub.add_parser("merge", help="直列化された唯一の main 反映経路")
    p.add_argument("slug", nargs="?")
    p.add_argument("--seen")
    p.add_argument("--allow-lost-symbols", dest="allow_lost_symbols", default="")
    p.add_argument("--reason", default="")

    p = sub.add_parser("release", help="claim の自発的解放")
    p.add_argument("slug", nargs="?")
    p.add_argument("--force", action="store_true")

    p = sub.add_parser("evict", help="TTL 切れ claim / lock の掃除")
    p.add_argument("--dry-run", dest="dry_run", action="store_true")
    p.add_argument("--lock-only", dest="lock_only", action="store_true")

    p = sub.add_parser("doctor", help="read-only の健全性検査（状態を一切変更しない）")
    p.add_argument("--run-tests", dest="run_tests", action="store_true")
    return ap


COMMANDS = {
    "directive": cmd_directive, "start": cmd_start, "sync": cmd_sync,
    "status": cmd_status, "done": cmd_done, "merge": cmd_merge,
    "release": cmd_release, "evict": cmd_evict, "doctor": cmd_doctor,
}


def main(argv):
    args = build_parser().parse_args(argv)
    CTX.cmd = args.cmd
    CTX.json_mode = bool(getattr(args, "json", False))
    try:
        if args.cmd == "doctor":
            resolve_repo()       # doctor は config 欠如/破損も検査対象のため soft 読込（§8.9）
        else:
            resolve_context()
        COMMANDS[args.cmd](args)
    except AgentsExit as e:
        if e.msg:
            if e.code == 8 and not CTX.json_mode:
                print(e.msg)                    # exit 8 は stdout にも出す（§14）
            print(e.msg, file=sys.stderr)
        if not CTX.json_mode and args.cmd != "directive":
            print(REMINDER)
        return e.code
    except KeyboardInterrupt:
        return 130
    if not CTX.json_mode and args.cmd != "directive":
        print(REMINDER)                          # 固定リマインド行（§8.0）
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
