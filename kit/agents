def cmd_directive(args):
    text = args.text
    if not text or not text.strip():
        raise AgentsExit(2, "指示原文が空。agents directive \"<指示の原文>\"")
    supersedes = [parse_directive_arg(x) for x in
                  ([s for s in (args.supersedes or "").split(",") if s.strip()])]
    ident = self_ident()
    by = ident["agent"] if ident else "main"
    box = {}

    def mutate(st):
        seq = st.counter + 1
        missing = [q for q in supersedes if q not in st.directives]
        if missing:
            box["warn"] = ("supersedes の参照先が存在しない: %s（記録は続行）"
                           % ", ".join(fmt_d(q) for q in missing))
        obj = {"by": by, "recorded_at": now_iso(), "scope": args.scope or "",
               "seq": seq, "text": text}
        if supersedes:
            obj["supersedes"] = sorted(supersedes)
        box["seq"] = seq
        return [("put", "directives/%s.json" % fmt_d(seq), state_dumps(obj)),
                ("put", "counter", ("%d\n" % seq).encode())]

    write_state(None, mutate, lambda: "directive %s" % fmt_d(box["seq"]))
    seq = box["seq"]
    if args.json:
        if box.get("warn"):
            # JSON 本文を汚さず stderr へ（§8.1/§4.2: 警告表示のみで記録は続行）
            print("警告: " + box["warn"], file=sys.stderr)
        print(json.dumps({"directive": fmt_d(seq), "seq": seq},
                         ensure_ascii=False, indent=1, sort_keys=True))
        return
    print(fmt_d(seq))
    if box.get("warn"):
        print("警告: " + box["warn"])
    scope = (args.scope or "").strip()
    print("記録した: %s%s" % (("[%s] " % scope) if scope else "", text))
    print("担当を取るなら: agents start <slug> --directive %s --paths \"<glob,...>\" --intent \"<1行>\""
          % fmt_d(seq))


def cmd_start(args):
    slug = args.slug
    if not SLUG_RE.match(slug) or slug in RESERVED_SLUGS:
        raise AgentsExit(2, "slug が不正: %s（^[a-z0-9][a-z0-9-]{0,39}$、予約語 merge/state/evict 不可）" % slug)
    paths = []
    for p in (args.paths or "").split(","):
        p = p.strip()
        if not p:
            continue
        while p.startswith("/") or p.startswith("./"):
            p = p[1:] if p.startswith("/") else p[2:]
        paths.append(p)
    if not paths:
        raise AgentsExit(2, "--paths が空。触るパスの glob をカンマ区切りで宣言せよ")
    intent = (args.intent or "").strip()
    if not intent:
        raise AgentsExit(2, "--intent が空。1 行の意図を書け")
    dseq = parse_directive_arg(args.directive)
    interfaces = [s.strip() for s in (args.interfaces or "").split(",") if s.strip()]

    agent = secrets.token_hex(3)
    branch = "agent/%s/%s" % (agent, slug)
    wt_abs = worktree_root_abs() / ("%s-%s" % (slug, agent))
    try:
        wt_rel = str(wt_abs.relative_to(CTX.root))
    except ValueError:
        wt_rel = str(wt_abs)
    fetch_main()
    box = {}

    def precheck(st):
        # CAS ループ内で毎回 (a)(b)(c) と base_sha を取り直す（I-CAS / I-SHA）
        if dseq not in st.directives:
            return (3, "directive %s が存在しない。先に agents directive で記録せよ" % fmt_d(dseq))
        other = st.claims.get(slug)
        if other is not None:
            return (4, ("slug %s は使用中。\n  agent=%s intent=%s paths=%s 経過=%s\n"
                        "別 slug にするか、agents sync で状況確認、必要なら agents evict --dry-run で生死確認")
                    % (slug, other.get("agent"), other.get("intent"),
                       ",".join(other.get("paths", [])), fmt_age(other.get("refreshed_at"))))
        fetch_main()
        base_sha = rev_parse_q("refs/remotes/%s/%s" % (R(), M()))
        if base_sha is None:
            return (3, "refs/remotes/%s/%s が無い。install.sh とブートストラップ push を確認せよ" % (R(), M()))
        files = ls_tree_files(base_sha)
        for oslug, oc in st.claims.items():
            pair = find_overlap(paths, oc.get("paths", []), files)
            if pair:
                return (4, ("パス重複: 自分の %r と claim %s（intent=%s, agent=%s）の %r が交差する。\n"
                            "パス宣言を狭めるか、相手の完了を待て（機械判定は安全側の過検出。§6）")
                        % (pair[0], oslug, oc.get("intent"), oc.get("agent"), pair[1]))
        st.extra["base_sha"] = base_sha
        return None

    def mutate(st):
        base_sha = st.extra["base_sha"]
        box["base_sha"] = base_sha
        box["maxd"] = st.maxd
        box["dtext"] = st.directives[dseq].get("text", "")
        box["others"] = [(s2, c2) for s2, c2 in sorted(st.claims.items())]
        box["tail"] = sorted(st.directives.keys())[-5:]
        box["dirs"] = st.directives
        now = now_iso()
        claim = {"agent": agent, "base_sha": base_sha, "branch": branch,
                 "claimed_at": now, "directive": dseq, "intent": intent,
                 "interfaces": interfaces, "paths": paths, "refreshed_at": now,
                 "seen": st.maxd, "slug": slug, "status": "active", "worktree": wt_rel}
        return [("put", "claims/%s.json" % slug, state_dumps(claim))]

    write_state(precheck, mutate, "claim %s (%s)" % (slug, agent))
    base_sha = box["base_sha"]

    # worktree 作成（I-SHA: 明示 SHA 起点。§8.2 手順5）
    try:
        worktree_root_abs().mkdir(parents=True, exist_ok=True)
    except OSError:
        pass

    def cleanup():
        git(["worktree", "remove", "--force", str(wt_abs)])
        git(["branch", "-D", branch])
        git(["worktree", "prune"])

    try:
        worktree_retry(["worktree", "add", "-b", branch, str(wt_abs), base_sha], cleanup=cleanup)
    except AgentsExit as e:
        # ロールバック: 自分の claim だけを削除（他者の再claim を消さない。I-OWNER）
        def rb_pre(st):
            c = st.claims.get(slug)
            if c is None or c.get("agent") != agent:
                return (8, "claim は既に失われている（別セッションが再claim した可能性）。claim 削除は行わない")
            st.extra["c"] = c
            return None

        def rb_mut(st):
            return [("del", "claims/%s.json" % slug)]

        try:
            write_state(rb_pre, rb_mut, "release %s" % slug)
        except AgentsExit as e2:
            print("警告: claim ロールバックに失敗: %s" % (e2.msg or e2.code), file=sys.stderr)
        raise AgentsExit(6, "worktree 作成に失敗（claim はロールバック済み）:\n%s" % (e.msg or ""))

    gd = git(["rev-parse", "--absolute-git-dir"], cwd=wt_abs)
    if gd.returncode != 0:
        raise AgentsExit(6, "worktree の gitdir 解決に失敗: " + _t(gd.stderr))
    (Path(_t(gd.stdout).strip()) / "agents.json").write_text(
        json.dumps({"slug": slug, "agent": agent, "branch": branch},
                   ensure_ascii=False, indent=1, sort_keys=True) + "\n", encoding="utf-8")

    print("claim 完了: %s (agent=%s)" % (slug, agent))
    print("worktree: %s" % wt_abs)
    print("branch:   %s" % branch)
    print("base_sha: %s" % base_sha[:12])
    print("directive: %s %s" % (fmt_d(dseq), box["dtext"]))
    others = [(s2, c2) for s2, c2 in box["others"] if s2 != slug and c2.get("status") == "active"]
    if others:
        print("他の active claim（intent/interfaces を読み、意味の衝突が無いか判断せよ）:")
        for s2, c2 in others:
            print("  - %s (agent=%s) intent=%s paths=%s interfaces=%s"
                  % (s2, c2.get("agent"), c2.get("intent"),
                     ",".join(c2.get("paths", [])), ",".join(c2.get("interfaces", []))))
    if box["tail"]:
        print("直近 directive:")
        for q in box["tail"]:
            d = box["dirs"][q]
            print("  %s %s%s" % (fmt_d(q), ("[%s] " % d["scope"]) if d.get("scope") else "",
                                 d.get("text", "").splitlines()[0] if d.get("text") else ""))
    print("cd %s して作業せよ。以後の agents コマンドはその worktree 内で実行"
          "（実体はどの checkout にも入っている `.agents/bin/agents`。"
          "見つからない場合は絶対パス `%s/.agents/bin/agents` を使え）。"
          "定期的に agents sync（claim の延命は worktree 内での sync だけが行う）。"
          % (wt_abs, CTX.root))


def _collect_view(st, main_sha, ident):
    """sync/status 共通の表示データ組み立て。"""
    lost = False
    if ident:
        c = st.claims.get(ident["slug"])
        if c is None or c.get("agent") != ident["agent"]:
            lost = True
    return lost


def _render_state(st, main_sha, ident, lost, prs=None):
    warnings = []
    if lost:
        print("!! あなたの claim %s は失われた（evict/release/再claim）。"
              "作業を止め、PROTOCOL.md『claim が evict されていた』に従え" % ident["slug"])
        warnings.append("claim_lost")

    self_claim = st.claims.get(ident["slug"]) if (ident and not lost) else None
    line = "main: %s" % (main_sha[:12] if main_sha else "(未fetch)")
    if self_claim and main_sha:
        rb = git(["rev-list", "--count", "%s..%s" % (self_claim.get("base_sha"), main_sha)])
        if rb.returncode == 0:
            line += "（base_sha からの遅れ: %s コミット）" % _t(rb.stdout).strip()
    print(line)

    if st.lock:
        stale = lock_stale(st.lock)
        print("lock: 保持者 %s/%s 取得 %s%s"
              % (st.lock.get("agent"), st.lock.get("slug"), fmt_age(st.lock.get("acquired_at")),
                 " !! STALE — agents evict --dry-run で生死確認の上 agents evict --lock-only" if stale else ""))
        if stale:
            warnings.append("stale_lock")
    else:
        print("lock: なし")

    print("claims:")
    if not st.claims:
        print("  （なし）")
    for slug in sorted(st.claims):
        c = st.claims[slug]
        stale = claim_stale(c)
        if stale:
            warnings.append("stale_claim")
        note = "" if worktree_exists(c) else " (worktree不在 — 別クローンの作業か、start 途中死の可能性)"
        prcol = ""
        if prs and c.get("branch") in prs:
            n, url = prs[c["branch"]]
            prcol = " PR#%s %s" % (n, url)
        print("  %-20s %s %-6s 開始%s 更新%s%s paths=%s intent=%s%s%s"
              % (slug, c.get("agent"), c.get("status"),
                 fmt_age(c.get("claimed_at")), fmt_age(c.get("refreshed_at")),
                 " !! STALE" if stale else "", ",".join(c.get("paths", [])),
                 c.get("intent"), note, prcol))

    print("directives:")
    seqs = sorted(st.directives.keys())
    shown = seqs if getattr(CTX, "show_all_directives", False) else seqs[-DIRECTIVE_TAIL:]
    new_seen = int(self_claim.get("seen", 0)) if self_claim else None
    has_new = False
    for q in shown:
        d = st.directives[q]
        mark = ""
        if new_seen is not None and q > new_seen:
            mark = "!! NEW "
            has_new = True
        sup = (" ⊃ " + ",".join(fmt_d(x) for x in d["supersedes"])) if d.get("supersedes") else ""
        text1 = d.get("text", "").replace("\n", " ")
        scope = ("[%s] " % d["scope"]) if d.get("scope") else ""
        print("  %s%s %s%s%s" % (mark, fmt_d(q), scope, text1, sup))
    if not seqs:
        print("  （なし）")

    orphans = list_orphans(st)
    if orphans:
        print("孤児 worktree（どの claim にも属さない）:")
        for o in orphans:
            print("  - %s" % o)
        print("  中身（未 push の作業）を確認し、ユーザーに報告してから片付けよ。")

    warn_lines = []
    if not CTX.cfg.get("test_cmd"):
        warn_lines.append("test_cmd 未設定。done/merge は拒否される。config.json に設定せよ（テスト無しなら \"true\"）")
        warnings.append("test_cmd_unset")
    if not hook_check_ok():
        warn_lines.append("main 直 push 防壁が実効フックパスに無い/不整合。install.sh を再実行せよ")
        warnings.append("hook_missing")
    if any(claim_stale(c) for c in st.claims.values()):
        warn_lines.append("stale claim あり。evict の前に `agents evict --dry-run` で確認せよ。"
                          "自分の別ターミナルが生きているかもしれない")
    if has_new:
        warn_lines.append("!! NEW を読み、自分の作業と矛盾しないか判断せよ。矛盾したら "
                          "PROTOCOL.md『新 directive と矛盾したら』へ。done/merge には "
                          "--seen d<最大seq> が必要")
        warnings.append("new_directives")
    if main_dirty():
        warn_lines.append("主 checkout が汚れている。AI セッションは ROOT に書き込むな（人間の作業なら無視してよい）")
        warnings.append("main_dirty")
    if ident is None:
        warn_lines.append("注意: ここでは claim は延命されない。延命は作業 worktree 内の sync のみ")
    if warn_lines:
        print("警告:")
        for w in warn_lines:
            print("  - %s" % w)
    return warnings, orphans


def _json_state(st, main_sha, ident, lost, warnings, orphans):
    self_obj = None
    if ident:
        self_obj = {"slug": ident["slug"], "agent": ident["agent"], "branch": ident["branch"]}
    obj = {
        "main_sha": main_sha,
        "state_tip": st.tip,
        "lock": st.lock,
        "claims": [st.claims[s] for s in sorted(st.claims)],
        "directives": [st.directives[q] for q in sorted(st.directives)],
        "self": self_obj,
        "orphans": orphans,
        "warnings": sorted(set(warnings)),
    }
    print(json.dumps(obj, ensure_ascii=False, indent=1, sort_keys=True))


def cmd_sync(args):
    CTX.show_all_directives = args.all
    st = read_state()
    fetch_main()
    main_sha = rev_parse_q("refs/remotes/%s/%s" % (R(), M()))
    ident = self_ident()
    lost = _collect_view(st, main_sha, ident)

    if args.json:
        # §8.3 は手順3（表示）→手順4（延命）の順。JSON を先に出してから延命する
        # （延命 CAS 中の claim 喪失レースでも「JSON なしの exit 8」を返さない）
        warnings, orphans = _json_warnings(st, main_sha, ident, lost)
        _json_state(st, main_sha, ident, lost, warnings, orphans)
        sys.stdout.flush()
        _refresh_if_needed(st, ident, lost)
        if lost:
            raise AgentsExit(8, None)
        return
    warnings, orphans = _render_state(st, main_sha, ident, lost)
    _refresh_if_needed(st, ident, lost)
    if lost:
        raise AgentsExit(8, "!! あなたの claim %s は失われた（evict/release/再claim）。"
                            "作業を止め、PROTOCOL.md『claim が evict されていた』に従え" % ident["slug"])


def _json_warnings(st, main_sha, ident, lost):
    warnings = []
    if lost:
        warnings.append("claim_lost")
    if not CTX.cfg.get("test_cmd"):
        warnings.append("test_cmd_unset")
    if not hook_check_ok():
        warnings.append("hook_missing")
    if st.lock and lock_stale(st.lock):
        warnings.append("stale_lock")
    if any(claim_stale(c) for c in st.claims.values()):
        warnings.append("stale_claim")
    self_claim = st.claims.get(ident["slug"]) if (ident and not lost) else None
    if self_claim and st.maxd > int(self_claim.get("seen", 0)):
        warnings.append("new_directives")
    if main_dirty():
        warnings.append("main_dirty")
    return warnings, list_orphans(st)


def _refresh_if_needed(st, ident, lost):
    """§8.3 手順4: 延命は claim worktree 内かつ自 claim（I-OWNER）のみ。"""
    if not ident or lost:
        return
    c = st.claims.get(ident["slug"])
    if c is None:
        return
    m = age_minutes(c.get("refreshed_at"))
    if m is None or m <= CTX.cfg["claim_ttl_hours"] * 60 / 4.0:
        return
    slug, agent = ident["slug"], ident["agent"]

    def precheck(st2):
        c2 = st2.claims.get(slug)
        if c2 is None or c2.get("agent") != agent:
            return (8, "!! あなたの claim %s は失われた（evict/release/再claim）。"
                       "作業を止め、PROTOCOL.md『claim が evict されていた』に従え" % slug)
        st2.extra["c"] = c2
        return None

    def mutate(st2):
        c2 = dict(st2.extra["c"])
        c2["refreshed_at"] = now_iso()
        return [("put", "claims/%s.json" % slug, state_dumps(c2))]

    write_state(precheck, mutate, "refresh %s" % slug)


def cmd_status(args):
    tip = rev_parse_q("refs/remotes/%s/%s" % (R(), S()))
    if tip is None:
        raise AgentsExit(3, "未 fetch。agents sync を実行せよ")
    st = load_state_from_tip(tip)
    main_sha = rev_parse_q("refs/remotes/%s/%s" % (R(), M()))
    ident = self_ident()
    lost = _collect_view(st, main_sha, ident)
    prs = None
    if shutil.which("gh"):
        r = gh_run(["pr", "list", "--json", "number,headRefName,baseRefName,title,url"])
        if r is not None and r.returncode == 0:
            try:
                prs = {p["headRefName"]: (p["number"], p["url"]) for p in json.loads(_t(r.stdout))}
            except Exception:
                prs = None
    if args.json:
        warnings, orphans = _json_warnings(st, main_sha, ident, lost)
        _json_state(st, main_sha, ident, lost, warnings, orphans)
        return
    _render_state(st, main_sha, ident, lost, prs=prs)


def cmd_done(args):
    ident = self_ident()
    if ident is None:
        raise AgentsExit(3, "claim worktree 内で実行せよ（agents start が作った worktree に cd する）")
    slug, agent, branch = ident["slug"], ident["agent"], ident["branch"]
    wt = cwd_toplevel()
    rs = git(["status", "--porcelain"], cwd=wt)
    dirty = _t(rs.stdout).strip()
    if dirty:
        print(dirty)
        raise AgentsExit(3, "未コミットの変更がある。作業成果はコミットし、生成物"
                            "（__pycache__ 等のビルド副産物）は削除するか repo の .gitignore に追記せよ"
                            "（rebase 途中ならば解消して git rebase --continue）")
    st = read_state()
    c = st.claims.get(slug)
    if c is None or c.get("agent") != agent:
        raise AgentsExit(8, "claim は evict/release 済み、または同 slug が別セッションに再claim 済み。"
                            "あなたの変更は claim に反映してはならない。"
                            "PROTOCOL.md『claim が evict されていた』へ")
    seen_arg = parse_directive_arg(args.seen) if args.seen else None
    directive_gate(st, slug, agent, None, seen_arg, "done")

    fetch_main()
    rr = git(["rebase", "refs/remotes/%s/%s" % (R(), M())], cwd=wt)
    sys.stdout.write(_t(rr.stdout))
    sys.stderr.write(_t(rr.stderr))
    if rr.returncode != 0:
        raise AgentsExit(6, "rebase がコンフリクトで停止した。"
                            "解消 → git add → git rebase --continue → 再度 agents done")
    require_test_cmd()
    fail = run_build_and_test(wt)
    if fail:
        raise AgentsExit(6, "%s が失敗した。push しない。直してから再度 agents done" % fail)

    # push 直前の branch fetch（応答喪失後の lease 恒久拒否の防止。§8.5 手順7）
    fetch_branch(branch, allow_missing=True)
    rp = git(["push", "--force-with-lease", R(), "HEAD:refs/heads/%s" % branch], cwd=wt)
    if rp.returncode != 0:
        raise AgentsExit(6, "branch push に失敗:\n" + _t(rp.stderr))

    pr_url = None
    if gh_enabled():
        r = gh_run(["pr", "list", "--head", branch, "--json", "number,baseRefName,url"])
        existing = None
        if r is not None and r.returncode == 0:
            try:
                lst = json.loads(_t(r.stdout))
                existing = lst[0] if lst else None
            except Exception:
                existing = None
        if existing:
            pr_url = existing.get("url")
            if existing.get("baseRefName") != M():
                r2 = gh_run(["pr", "edit", str(existing["number"]), "--base", M()])
                if r2 is None or r2.returncode != 0:
                    print("警告: 既存 PR の base 矯正に失敗（続行）", file=sys.stderr)
        else:
            c0 = st.claims.get(slug, {})
            r3 = gh_run(["pr", "create", "--base", M(), "--head", branch,
                         "--title", "%s: %s" % (slug, c0.get("intent", "")),
                         "--body", "directive %s / agents-kit" % fmt_d(int(c0.get("directive", 0)))])
            if r3 is not None and r3.returncode == 0:
                pr_url = _t(r3.stdout).strip()
            else:
                print("警告: PR 作成に失敗（続行。merge には影響しない）", file=sys.stderr)

    def precheck(st2):
        c2 = st2.claims.get(slug)
        if c2 is None or c2.get("agent") != agent:
            return (8, "claim は evict/release 済み、または別セッションに再claim 済み。"
                       "PROTOCOL.md『claim が evict されていた』へ")
        st2.extra["c"] = c2
        return None

    def mutate(st2):
        c2 = dict(st2.extra["c"])
        c2["status"] = "ready"
        c2["refreshed_at"] = now_iso()
        return [("put", "claims/%s.json" % slug, state_dumps(c2))]

    write_state(precheck, mutate, "ready %s" % slug)
    print("done: %s は ready。次: agents merge %s" % (slug, slug))
    if pr_url:
        print("PR: %s" % pr_url)


