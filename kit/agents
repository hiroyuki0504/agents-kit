def _hook_selftest(block, remote_ref, env_extra):
    """マーカー間ブロックだけを sh で合成 stdin 実行する（ユーザーの後続フック本体は
    実行しない＝副作用なし）。戻り値は exit code（実行不能は -1）。"""
    env = dict(os.environ)
    env.pop("AGENTS_MERGE_TOKEN", None)
    env.pop("AGENTS_STATE_TOKEN", None)
    env["LC_ALL"] = "C"
    env["LANG"] = "C"
    env["GIT_DIR"] = str(CTX.common_gitdir)   # ブロックの stdin 退避先（実 push 時と同じ規約）
    env.update(env_extra)
    z = "0" * 40
    line = "refs/heads/x %s %s %s\n" % (z, remote_ref, z)
    try:
        r = subprocess.run(["sh", "-c", block], input=line.encode(),
                           cwd=str(CTX.root), env=env, timeout=10,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        return r.returncode
    except Exception:
        return -1


def hook_check_ok():
    """実効フックパスの pre-push の防壁検査（§8.3）。

    (i) マーカー存在、(ii) ブロック内に守備ブランチ名、(iii) 到達可能性
    （ブロックより前に実行文が無い＝前段の早期 exit で防壁が死んでいない）、
    (iv) ブロック単体の挙動セルフテスト（トークン無しの保護 ref push を拒否し、
    トークン有り・非保護 ref は通すこと）。文字列存在だけでは「exit 0 の後ろの
    死んだブロック」を健全と誤報告するため、(iii)(iv) を必須とする。
    """
    f = effective_hook_dir() / "pre-push"
    try:
        text = f.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    if HOOK_MARKER not in text or HOOK_MARKER_END not in text:
        return False
    lines = text.split("\n")
    start_idx = next(i for i, ln in enumerate(lines) if HOOK_MARKER in ln)
    end_idx = next((i for i, ln in enumerate(lines) if HOOK_MARKER_END in ln), None)
    if end_idx is None or end_idx <= start_idx:
        return False
    block = "\n".join(lines[start_idx:end_idx + 1])
    if ("refs/heads/%s" % M()) not in block or ("refs/heads/%s" % S()) not in block:
        return False
    for ln in lines[:start_idx]:              # (iii) shebang・コメント・空行のみ許可
        s2 = ln.strip()
        if s2 and not s2.startswith("#"):
            return False
    return (_hook_selftest(block, "refs/heads/%s" % M(), {}) != 0
            and _hook_selftest(block, "refs/heads/%s" % S(), {}) != 0
            and _hook_selftest(block, "refs/heads/%s" % M(), {"AGENTS_MERGE_TOKEN": "1"}) == 0
            and _hook_selftest(block, "refs/heads/agents-kit-selftest", {}) == 0)


def claim_stale(c):
    m = age_minutes(c.get("refreshed_at"))
    return m is not None and m > CTX.cfg["claim_ttl_hours"] * 60


def lock_stale(lock):
    m = age_minutes(lock.get("acquired_at"))
    ttl = lock.get("ttl_min", CTX.cfg["merge_lock_ttl_min"])
    return m is not None and m > ttl


def worktree_exists(c):
    w = c.get("worktree")
    if not w:
        return False
    p = Path(w)
    return (p if p.is_absolute() else CTX.root / p).is_dir()


def list_orphans(st):
    wr = worktree_root_abs()
    if not wr.is_dir():
        return []
    known = set()
    for c in st.claims.values():
        w = c.get("worktree")
        if w:
            p = Path(w)
            known.add(str((p if p.is_absolute() else CTX.root / p).resolve()))
    out = []
    for d in sorted(wr.iterdir()):
        if d.is_dir() and str(d.resolve()) not in known:
            try:
                rel = d.relative_to(CTX.root)
                out.append(str(rel))
            except ValueError:
                out.append(str(d))
    return out


