def resolve_repo():
    """git repo 検出と ROOT / COMMON_GITDIR の解決（§8.0 起動時共通処理の前半）。"""
    r = git_nocwd(["rev-parse", "--path-format=absolute", "--git-common-dir"])
    if r.returncode != 0:
        raise AgentsExit(3, "git リポジトリの中で実行せよ（git repo 外か bare）")
    common = Path(_t(r.stdout).strip())
    if common.name != ".git":
        raise AgentsExit(3, "bare リポジトリでは実行できない（git-common-dir が .git でない）")
    CTX.common_gitdir = common
    CTX.root = common.parent


def find_config_path():
    """config の探索: <現worktreeのtoplevel>/.agents/config.json → ROOT/.agents/config.json。"""
    top = None
    rt = git_nocwd(["rev-parse", "--show-toplevel"])
    if rt.returncode == 0:
        top = Path(_t(rt.stdout).strip())
    for base in ([top] if top else []) + [CTX.root]:
        p = base / ".agents" / "config.json"
        if p.is_file():
            return p
    return None


def resolve_context():
    resolve_repo()
    cfg_path = find_config_path()
    if cfg_path is None:
        raise AgentsExit(3, ".agents/config.json が無い。install.sh を実行せよ")
    try:
        raw = json.loads(cfg_path.read_text(encoding="utf-8"))
    except Exception as e:
        raise AgentsExit(3, "config.json のパースに失敗: %s (%s)" % (cfg_path, e))
    if not isinstance(raw, dict):
        raise AgentsExit(3, "config.json はオブジェクトであるべき: %s" % cfg_path)
    unknown = [k for k in raw if k not in CONFIG_DEFAULTS]
    if unknown:
        print("警告: config.json に未知のキー: %s" % ", ".join(sorted(unknown)), file=sys.stderr)
    cfg = dict(CONFIG_DEFAULTS)
    cfg.update({k: v for k, v in raw.items() if k in CONFIG_DEFAULTS})
    CTX.cfg = cfg

    # 一時 index 置き場の準備と軽量 GC（24h より古い残骸を黙って削除。§14）
    tmpdir = CTX.common_gitdir / "agents-tmp"
    try:
        tmpdir.mkdir(parents=True, exist_ok=True)
        cutoff = time.time() - 24 * 3600
        for f in tmpdir.iterdir():
            try:
                if f.is_file() and f.stat().st_mtime < cutoff:
                    f.unlink()
            except OSError:
                pass
    except OSError:
        pass


def git_nocwd(args):
    env = dict(os.environ)
    env["LC_ALL"] = "C"
    env["LANG"] = "C"
    return subprocess.run(["git"] + args, cwd=os.getcwd(), env=env,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)


