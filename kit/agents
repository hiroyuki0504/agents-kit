def _unlock(run):
    """§8.6b UNLOCK。手順3成功後のあらゆる失敗 exit はここを経由する。"""
    def precheck(st):
        if st.lock is None or st.lock.get("agent") != run:
            return (0, "ロックは自分のものではないため触らない")
        return None

    def mutate(st):
        return [("del", "locks/merge.json")]

    try:
        write_state(precheck, mutate, "unlock merge", on_precheck_fail="skip")
    except AgentsExit as e:
        print("警告: UNLOCK に失敗（TTL が回収する）: %s" % (e.msg or e.code), file=sys.stderr)


def _lock_acquire(run, slug):
    box = {"takeover": None}

    def precheck(st):
        lk = st.lock
        if lk is None:
            box["takeover"] = None
            return None
        if lock_stale(lk):
            box["takeover"] = (lk.get("agent"), lk.get("slug"),
                               int(age_minutes(lk.get("acquired_at")) or 0))
            return None
        remain = int((lk.get("ttl_min", CTX.cfg["merge_lock_ttl_min"])
                      - (age_minutes(lk.get("acquired_at")) or 0)))
        return (4, "merge ロック保持者 %s/%s、残 %d 分。30〜60 秒おきに再実行して待て"
                   "（保持者の merge はテスト実行を含むため数分かかりうる）"
                % (lk.get("agent"), lk.get("slug"), max(remain, 0)))

    def mutate(st):
        # stale ロックは同一 CAS commit 内で置換（put が上書き）
        obj = {"acquired_at": now_iso(), "agent": run, "slug": slug,
               "ttl_min": CTX.cfg["merge_lock_ttl_min"]}
        return [("put", "locks/merge.json", state_dumps(obj))]

    write_state(precheck, mutate, "lock merge %s" % slug)
    if box["takeover"]:
        a, s2, mins = box["takeover"]
        print("stale ロック（%s/%s, %d分）を奪取した。前保持者のテストがまだ走っている可能性はあるが、"
              "安全は main push の FF 検査が守る。奪取警告が出ても手動修復は不要" % (a, s2, mins))


def _heartbeat(run, slug):
    """§8.6 手順8 前半。precheck 不成立は警告のみで続行（on_precheck_fail="skip" 許可箇所）。"""
    def precheck(st):
        if st.lock is None or st.lock.get("agent") != run:
            return (0, "ロックは奪取されている。安全は push の FF 検査が守るので続行する")
        st.extra["lk"] = st.lock
        return None

    def mutate(st):
        lk = dict(st.extra["lk"])
        lk["acquired_at"] = now_iso()
        return [("put", "locks/merge.json", state_dumps(lk))]

    write_state(precheck, mutate, "heartbeat merge %s" % slug, on_precheck_fail="skip")


def _worktree_remove(path, warn_only=False):
    def cleanup():
        git(["worktree", "prune"])
    try:
        worktree_retry(["worktree", "remove", "--force", str(path)], cleanup=cleanup)
        git(["worktree", "prune"])
    except AgentsExit as e:
        if warn_only:
            print("警告: merge worktree の除去に失敗: %s" % (e.msg or ""), file=sys.stderr)
        else:
            raise


def _lease_delete_branch(branch0, br_tip):
    """§8.6 手順12a: 検証時 tip のままのときだけ削除（I-VERIFY-THEN-DELETE）。

    lease 拒否の判定は lease 固有パターン（stale info / incorrect old value）に限定する。
    削除保護・pre-receive 等の他の remote rejected を lease 拒否と誤診断すると
    「done をやり直せ」という解決しない誤誘導ループになるため、そちらは stderr 全文つきの
    一般警告に落とす。lease 分岐でも stderr 全文を併記する（真因を隠さない）。
    """
    r = git(["push", "--force-with-lease=refs/heads/%s:%s" % (branch0, br_tip),
             R(), ":refs/heads/%s" % branch0])
    if r.returncode != 0:
        err = _t(r.stderr)
        if "stale info" in err or "incorrect old value" in err:
            print("警告: branch の tip が検証時から動いている（lease 拒否）ため削除しなかった。"
                  "所有者は agents done をやり直せ:\n" + err.rstrip())
        else:
            print("警告: リモート branch 削除に失敗（残置。手動確認可）:\n" + err.rstrip(), file=sys.stderr)
    rb = git(["branch", "-D", branch0])
    if rb.returncode != 0:
        print("警告: ローカル branch %s は削除できなかった（claim worktree で checkout 中なら正常）" % branch0)


def _merge_log_obj(seq, slug, agent0, branch0, br, directive, seen_ok,
                   main_before, main_after, merge_commit, tests, recovery,
                   allowed_lost=None, reason=None):
    obj = {"agent": agent0, "allowed_lost": allowed_lost or [], "branch": branch0,
           "branch_tip": br, "directive": directive, "kind": "merge",
           "main_after": main_after, "main_before": main_before,
           "merge_commit": merge_commit, "merged_at": now_iso(),
           "recovery": recovery, "seen": seen_ok, "seq": seq, "slug": slug,
           "tests": tests}
    if reason:
        obj["reason"] = reason
    return obj


def cmd_merge(args):
    run = secrets.token_hex(3)                     # 手順0: run token（claim の agent とは別物）
    if args.slug:
        slug = args.slug
    else:
        ident = self_ident()
        if ident is None:
            raise AgentsExit(2, "worktree 外では slug を指定せよ: agents merge <slug>")
        slug = ident["slug"]
    allow = [s.strip() for s in (args.allow_lost_symbols or "").split(",") if s.strip()]
    if allow and not (args.reason or "").strip():
        raise AgentsExit(2, "--allow-lost-symbols には --reason \"<1行>\" が必須")

    # 手順1: 前提
    require_test_cmd()
    st = read_state()
    claim = st.claims.get(slug)
    if claim is None:
        raise AgentsExit(3, "claim が無い。evict/merge 済みか slug 誤り")
    if claim.get("status") != "ready":
        raise AgentsExit(3, "claim %s は active。先に agents done" % slug)
    agent0, branch0 = claim.get("agent"), claim.get("branch")
    directive0 = int(claim.get("directive", 0))
    intent0 = claim.get("intent", "")

    # 手順2: directive ゲート（agent0/branch0 一致検査つき）
    seen_arg = parse_directive_arg(args.seen) if args.seen else None
    seen_ok = directive_gate(st, slug, agent0, branch0, seen_arg, "merge %s" % slug)

    # 手順3: ロック取得。以降のあらゆる失敗 exit は UNLOCK 経由（§8.6b）
    _lock_acquire(run, slug)
    locked = True
    try:
        restarts = 0
        merge_sha = None
        wt = None
        while True:
            # 手順4（再走の起点は常にここ）
            fetch_main()
            if not fetch_branch(branch0, allow_missing=True):
                raise AgentsExit(3, "branch %s が push されていない。agents done をやり直せ" % branch0)
            br = rev_parse_q("refs/remotes/%s/%s" % (R(), branch0))
            if br is None:
                raise AgentsExit(3, "branch %s が push されていない。agents done をやり直せ" % branch0)
            local = rev_parse_q("refs/heads/%s" % branch0)
            if local is not None and local != br:
                raise AgentsExit(3, "ローカル %s に未 push コミットあり。agents done をやり直せ" % branch0)
            m_sha = rev_parse_q("refs/remotes/%s/%s" % (R(), M()))
            if m_sha is None:
                raise AgentsExit(6, "refs/remotes/%s/%s を解決できない" % (R(), M()))

            # 手順4b: 既マージ検出（回収経路）
            if is_ancestor(br, m_sha):
                _recovery(run, slug, agent0, branch0, br, m_sha, directive0, seen_ok)
                locked = False   # 4b の複合コミット（または UNLOCK 相当の条件つき削除）が処理済み
                _lease_delete_branch(branch0, br)
                return

            # 手順5: クリーン worktree
            wt = worktree_root_abs() / ("merge-%s" % run)

            def cleanup():
                git(["worktree", "remove", "--force", str(wt)])
                git(["worktree", "prune"])

            worktree_retry(["worktree", "add", "--detach", str(wt), m_sha], cleanup=cleanup)
            rs = git(["status", "--porcelain"], cwd=wt)
            if _t(rs.stdout).strip():
                raise AgentsExit(7, "クリーンであるべき新規 worktree が汚れている。"
                                    "repo の filter/EOL 設定を疑え（worktree: %s）" % wt)

            # 手順6: シミュレーション兼本マージ
            # メッセージに seen を併記する（intent は claim 作成時の文言のまま固定されるため、
            # 後勝ちで作り直された内容が入る場合の監査誤読を防ぐ。§4.6/運用実測より）
            rm = git(["merge", "--no-ff", "-m",
                      "merge %s (%s, seen %s): %s" % (slug, fmt_d(directive0), fmt_d(seen_ok), intent0), br],
                     cwd=wt)
            if rm.returncode != 0:
                sys.stdout.write(_t(rm.stdout))
                git(["merge", "--abort"], cwd=wt)
                _worktree_remove(wt, warn_only=True)
                raise AgentsExit(4, "マージコンフリクト。main が進んでいる。"
                                    "所有 worktree で agents done（rebase+テスト）をやり直してから再度 merge")
            merge_sha = rev_parse_q("HEAD", cwd=wt)

            # 手順7: シンボル消失チェック
            violations, unchecked = symbol_check(m_sha, br, merge_sha)
            if unchecked:
                print("未検査（拡張子表に無い/サイズ超過）:")
                for f, why in unchecked:
                    print("  - %s (%s)" % (f, why))
            remaining = [(f, s, k) for (f, s, k) in violations if s not in set(allow)]
            if remaining:
                print("シンボル消失を検出:")
                for f, s2, k in remaining:
                    print("  %s: %s (%s)" % (f, s2, k))
                raise AgentsExit(7, (
                    "まず merge worktree（%s）で消失箇所を目で確認せよ。"
                    "`--allow-lost-symbols` は**ユーザーの明示承認が無い限り使用禁止**"
                    "（--reason 必須、agent-state に記録され監査される）" % wt))

            # 手順8: ハートビート → build+test（1 マージごとにフルテスト。I-TEST-EACH）
            _heartbeat(run, slug)
            fail = run_build_and_test(wt)
            if fail:
                raise AgentsExit(6, "%s が失敗した。merge worktree を調査用に残した: %s" % (fail, wt))

            # 手順9: push 直前の directive 再確認 → main push（最終 CAS）
            st9 = read_state()
            if st9.maxd > seen_ok:
                # 全文→拒否文の順で stdout に出す（§8.5 手順4 と同じ表示順規律）
                new = [q for q in st9.directives if q > seen_ok]
                show_directives_full(st9, new)
                print("テスト中に新しい指示が記録された。読んで矛盾判断の上、"
                      "--seen %s を付けて merge を再実行せよ" % fmt_d(st9.maxd))
                sys.stdout.flush()
                _worktree_remove(wt, warn_only=True)
                raise AgentsExit(3, None)
            rp = git(["push", R(), "HEAD:refs/heads/%s" % M()], cwd=wt,
                     env_extra={"AGENTS_MERGE_TOKEN": "1"})
            if rp.returncode == 0:
                break
            err = _t(rp.stderr)
            if is_cas_stderr(err):
                _worktree_remove(wt, warn_only=True)
                if restarts < MERGE_RESTART_MAX:
                    restarts += 1
                    print("main が動いた（CAS 敗北）。新しい main に対して再マージ・再テストする（再走 %d/%d）"
                          % (restarts, MERGE_RESTART_MAX))
                    continue
                raise AgentsExit(5, "merge 再走上限。stderr 全文:\n" + err)
            raise AgentsExit(6, "main push に失敗（merge worktree を残した: %s）:\n%s" % (wt, err))

        # 手順10: 反映確認
        fetch_main()
        if not is_ancestor(merge_sha, rev_parse_q("refs/remotes/%s/%s" % (R(), M())) or ""):
            raise AgentsExit(7, "push 成功後の反映確認に失敗（merge commit が origin/%s の祖先でない）。"
                                "ブランチは消さない。ユーザーに報告せよ" % M())

        # 手順11: 状態確定（成功経路専用の複合コミット。lock 削除もここで行う）
        flags = {}

        def mutate(st2):
            seq = st2.counter + 1
            changes = [("put", "log/e%05d-merge-%s.json" % (seq, slug),
                        state_dumps(_merge_log_obj(seq, slug, agent0, branch0, br, directive0,
                                                   seen_ok, m_sha, merge_sha, merge_sha, "pass",
                                                   False, allow, (args.reason or "").strip() or None))),
                       ("put", "counter", ("%d\n" % seq).encode())]
            c2 = st2.claims.get(slug)
            if c2 is not None and c2.get("agent") == agent0 and c2.get("branch") == branch0:
                changes.append(("del", "claims/%s.json" % slug))
                flags.pop("claim_kept", None)
            elif c2 is not None:
                flags["claim_kept"] = True
            if st2.lock is not None and st2.lock.get("agent") == run:
                changes.append(("del", "locks/merge.json"))
                flags.pop("lock_kept", None)
            elif st2.lock is not None:
                flags["lock_kept"] = True
            return changes

        write_state(None, mutate, "merge-log %s" % slug)
        locked = False
        if flags.get("claim_kept"):
            print("警告: claim は merge 中に別セッションへ渡った。claim は残す")
        if flags.get("lock_kept"):
            print("警告: ロックが奪取されていた（安全性は手順9の FF 検査が担保済み）")

        # 手順12: 後片付け
        _lease_delete_branch(branch0, br)
        _worktree_remove(wt, warn_only=True)
        print("merged: %s → %s" % (merge_sha[:12], M()))
        print("PR があれば GitHub 上で自動的に merged になる")
        print("所有 worktree の片付け: 中身を確認し、未 push の変更が無いことを見てから "
              "git worktree remove <claim worktree>"
              "（生成物 __pycache__ 等だけが残って拒否される場合は --force でよい）")
    except AgentsExit:
        if locked:
            _unlock(run)
        raise


def _recovery(run, slug, agent0, branch0, br, m_sha, directive0, seen_ok):
    """§8.6 手順4b。テスト省略・first-parent 走査で実マージコミット特定・recovery ログ。"""
    rl = git(["rev-list", "--first-parent", "--parents", "-n", str(RECOVERY_SCAN), m_sha])
    merge_commit = main_before = main_after = None
    if rl.returncode == 0:
        for line in _t(rl.stdout).split("\n"):
            parts = line.split()
            if len(parts) >= 3 and parts[2] == br:   # 第2親が BR の行（§8.6 手順4b）
                merge_commit = parts[0]
                main_before = parts[1]
                main_after = merge_commit
                break
    flags = {}

    def mutate(st2):
        seq = st2.counter + 1
        changes = [("put", "log/e%05d-merge-%s.json" % (seq, slug),
                    state_dumps(_merge_log_obj(seq, slug, agent0, branch0, br, directive0,
                                               seen_ok, main_before, main_after, merge_commit,
                                               "skipped-recovery", True))),
                   ("put", "counter", ("%d\n" % seq).encode())]
        c2 = st2.claims.get(slug)
        if c2 is not None and c2.get("agent") == agent0 and c2.get("branch") == branch0:
            changes.append(("del", "claims/%s.json" % slug))
            flags.pop("claim_kept", None)
        elif c2 is not None:
            flags["claim_kept"] = True
        if st2.lock is not None and st2.lock.get("agent") == run:
            changes.append(("del", "locks/merge.json"))
        return changes

    write_state(None, mutate, "merge-log %s" % slug)
    if flags.get("claim_kept"):
        print("警告: claim は別セッションが再取得済み。claim は残す")
    print("既マージを検出し回収した: %s" % (merge_commit[:12] if merge_commit else "不明"))


def cmd_release(args):
    ident = self_ident()
    if args.slug:
        slug = args.slug
    else:
        if ident is None:
            raise AgentsExit(2, "worktree 外では slug を指定せよ: agents release <slug>")
        slug = ident["slug"]
    my_agent = ident["agent"] if ident else None
    box = {}

    def precheck(st):
        c = st.claims.get(slug)
        if c is None:
            return (3, "claim %s は存在しない" % slug)
        if not args.force and c.get("agent") != my_agent:
            return (3, "claim %s は他セッション（agent=%s）のもの。所有者が死んだと確信できる時のみ "
                       "agents release %s --force（迷ったらユーザーに確認）" % (slug, c.get("agent"), slug))
        st.extra["c"] = c
        return None

    def mutate(st):
        c = st.extra["c"]
        seq = st.counter + 1
        box["c"] = c
        obj = {"agent": c.get("agent"), "kind": "release",
               "released_at": now_iso(), "seq": seq, "slug": slug}
        return [("del", "claims/%s.json" % slug),
                ("put", "log/e%05d-release-%s.json" % (seq, slug), state_dumps(obj)),
                ("put", "counter", ("%d\n" % seq).encode())]

    write_state(precheck, mutate, "release %s" % slug)
    c = box["c"]
    print("released: %s" % slug)
    print("branch %s と worktree %s は残っている。中身（未 push の作業）を確認し、"
          "ユーザーに報告してから片付けよ: git worktree remove <path> / git push %s :refs/heads/%s"
          % (c.get("branch"), c.get("worktree"), R(), c.get("branch")))


def cmd_evict(args):
    st = read_state()
    stale_claims = {s: c for s, c in st.claims.items() if claim_stale(c)}
    stale_lock = st.lock if (st.lock and lock_stale(st.lock)) else None
    if args.lock_only:
        stale_claims = {}
    if not stale_claims and not stale_lock:
        print("対象なし")
        return
    print("evict 候補:")
    for s2, c in sorted(stale_claims.items()):
        note = "" if worktree_exists(c) else " (worktree不在)"
        print("  claim %s agent=%s 更新%s%s worktree=%s"
              % (s2, c.get("agent"), fmt_age(c.get("refreshed_at")), note, c.get("worktree")))
    if stale_lock:
        print("  lock 保持者=%s/%s 取得%s"
              % (stale_lock.get("agent"), stale_lock.get("slug"), fmt_age(stale_lock.get("acquired_at"))))
    if args.dry_run:
        print("--dry-run のため書き込みなし")
        return
    box = {"claims": [], "lock": False}

    def precheck(st2):
        return None

    def mutate(st2):
        # staleness を毎回再計算（CAS ループ中に持ち主が refresh/heartbeat したら対象から外す）
        targets = {s3: c3 for s3, c3 in st2.claims.items()
                   if s3 in stale_claims and claim_stale(c3)}
        lk = st2.lock if (stale_lock and st2.lock and lock_stale(st2.lock)) else None
        if not targets and lk is None:
            box["claims"], box["lock"] = [], False
            return []           # 全対象が消えていたら書き込まない
        seq = st2.counter + 1
        changes = []
        ev = []
        for s3, c3 in sorted(targets.items()):
            changes.append(("del", "claims/%s.json" % s3))
            ev.append({"agent": c3.get("agent"), "refreshed_at": c3.get("refreshed_at"), "slug": s3})
        if lk is not None:
            changes.append(("del", "locks/merge.json"))
        obj = {"evicted": ev, "evicted_at": now_iso(), "kind": "evict",
               "lock_evicted": lk is not None, "seq": seq}
        changes.append(("put", "log/e%05d-evict.json" % seq, state_dumps(obj)))
        changes.append(("put", "counter", ("%d\n" % seq).encode()))
        box["claims"] = [(s3, targets[s3]) for s3 in sorted(targets)]
        box["lock"] = lk is not None
        return changes

    res = write_state(precheck, mutate, lambda: "evict %d claims" % len(box["claims"]))
    if res is None and not box["claims"] and not box["lock"]:
        print("対象なし（CAS 中に延命された）")
        return
    for s3, c3 in box["claims"]:
        print("evicted: claim %s (agent=%s)" % (s3, c3.get("agent")))
    if box["lock"]:
        print("evicted: merge lock")
    paths = ", ".join(str(c3.get("worktree")) for _, c3 in box["claims"]) or "（なし）"
    print("worktree と branch は残置: %s。片付けはユーザーに報告し指示を得てから行え。"
          "未 push の作業が見えたら消すな" % paths)


