def parse_directive_arg(s):
    m = re.fullmatch(r"[dD]?0*(\d+)", str(s).strip())
    if not m:
        raise AgentsExit(2, "directive 指定が不正: %s（d00043 / d43 / 43 のいずれかの形式）" % s)
    return int(m.group(1))


def show_directives_full(st, seqs):
    for q in sorted(seqs):
        d = st.directives[q]
        head = "--- %s" % fmt_d(q)
        if d.get("scope"):
            head += " [%s]" % d["scope"]
        if d.get("supersedes"):
            head += " ⊃ " + ",".join(fmt_d(x) for x in d["supersedes"])
        print(head + " ---")
        print(d.get("text", ""))


def directive_gate(st, slug, agent0, branch0, seen_arg, cmd_word):
    """§8.5 手順4 / §8.6 手順2。復唱成功で claim.seen を CAS 更新。戻り値 SEEN_OK=maxd。

    branch0 が None のときは done（agent 一致のみ検査）。merge は (agent0, branch0) 一致。
    """
    claim = st.claims.get(slug)
    maxd = st.maxd
    seen = int(claim.get("seen", 0))
    if seen >= maxd and seen_arg is None:
        return maxd
    if seen_arg is None or seen_arg != maxd:
        unread = [q for q in st.directives if q > seen]
        show_directives_full(st, unread)
        # 拒否文は directive 全文と同じ stdout に、全文の後に出す（§8.5 手順4:
        # 完成形コマンドを出力の先頭に置かない。stderr に出すとパイプ捕捉＝AI ハーネスの
        # 統合キャプチャで stderr が先に flush され、完成形コマンドが全文より先頭に現れる）
        print("上記を読み、自分の作業と矛盾しないか判断せよ。記録漏れの口頭指示があるなら先に "
              "agents directive で記録せよ。矛盾が無いと判断した場合のみ、"
              "agents %s --seen %s で復唱して再実行"
              "（--seen は最大 seq を 1 つだけ指定。それ以下の全 directive を ack したことになる。"
              "自分が記録した directive は記録時点で ack 済み）" % (cmd_word, fmt_d(maxd)))
        sys.stdout.flush()
        raise AgentsExit(3, None)

    def precheck(st2):
        c = st2.claims.get(slug)
        if c is None or c.get("agent") != agent0 or (branch0 is not None and c.get("branch") != branch0):
            return (8, "claim %s は evict/release 済み、または別セッションに再claim 済み。"
                       "作業を止め、PROTOCOL.md『claim が evict されていた』へ" % slug)
        maxd2 = st2.maxd
        if maxd2 != seen_arg:
            # 全文→拒否文の順で stdout に出す（stderr 分離はパイプ捕捉で順序が逆転する）
            unread2 = [q for q in st2.directives if q > int(c.get("seen", 0))]
            show_directives_full(st2, unread2)
            print("さらに新しい directive が記録されている。読了の上、--seen %s で再実行" % fmt_d(maxd2))
            sys.stdout.flush()
            return (3, None)
        st2.extra["claim"] = c
        return None

    def mutate(st2):
        c = dict(st2.extra["claim"])
        c["seen"] = seen_arg
        c["refreshed_at"] = now_iso()
        return [("put", "claims/%s.json" % slug, state_dumps(c))]

    write_state(precheck, mutate, "seen %s %d" % (slug, seen_arg))
    return seen_arg


def run_stream(cmd, cwd, label):
    """sh -c で実行し、出力をチャンク単位で無遅延に tee しつつ末尾 TEST_LOG_TAIL 行を保持。

    行バッファ転写は禁止（§8.0）: 改行を伴わない進捗出力（pytest のドット等）が
    行完成まで滞留し、長いテストが停止に見える → merge を殺す誘因になる。
    """
    print("$ %s  (cwd=%s)" % (cmd, cwd))
    sys.stdout.flush()
    tail = deque(maxlen=TEST_LOG_TAIL)
    p = subprocess.Popen(["sh", "-c", cmd], cwd=str(cwd),
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    fd = p.stdout.fileno()
    carry = b""
    while True:
        try:
            chunk = os.read(fd, 65536)
        except OSError:
            break
        if not chunk:
            break
        sys.stdout.buffer.write(chunk)          # 読んだバイトを即転写（無遅延）
        sys.stdout.buffer.flush()
        carry += chunk
        parts = carry.split(b"\n")
        carry = parts.pop()
        for ln in parts:
            tail.append(ln.decode("utf-8", "replace"))
        if len(carry) > 1_000_000:              # 改行なし巨大出力でのメモリ膨張防止
            tail.append(carry.decode("utf-8", "replace"))
            carry = b""
    if carry:
        tail.append(carry.decode("utf-8", "replace"))
    p.stdout.close()
    rc = p.wait()
    if rc != 0:
        print("---- %s 失敗（末尾 %d 行を再掲）----" % (label, TEST_LOG_TAIL))
        for s in tail:
            print(s)
    return rc


